# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# resume build tool — keep resume.html + print-resume.mjs, ignore deps & outputs
/tools/resume/node_modules
/tools/resume/package.json
/tools/resume/package-lock.json
/tools/resume/ResumeBennettAnderson.pdf
/tools/resume/resume-preview.png
/tools/resume/make-thumb.mjs
/tools/resume/ba-thumb.png
