# Concierge node secrets — TEMPLATE ONLY (safe to commit, no real values).
# Copy this to `.env.local` in this folder (which is gitignored) and fill it in.
# NEVER put real tokens in this file or anywhere else that gets committed —
# the repo is public and auto-deploys.

# --- Upstash Redis: TCP/TLS URL (best for the Python poller, redis-py) ---
# From the Upstash console. Use the rediss:// (TLS) scheme for client libraries.
REDIS_URL=rediss://default:REPLACE_WITH_TOKEN@YOUR-DB.upstash.io:6379

# --- Upstash Redis: REST API (for the Vercel routes / @upstash/redis) ---
# Vercel serverless functions generally use the REST API rather than a raw TCP
# connection. Get these from the console's "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional shared secret between the site and the desktop node.
CONCIERGE_SHARED_SECRET=

# NOTE on token scope: the poller and the ask route must WRITE to Redis, so they
# need a read-write token. A read-only token only suffices for the status
# route's heartbeat read.
